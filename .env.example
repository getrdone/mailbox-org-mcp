# Copy to ~/.mailbox-org-mcp/.env (or point MAILBOX_SECRETS_FILE at another file).
# Environment variables set by your MCP client override these values.

# Required: your mailbox.org address and an app password with IMAP + SMTP rights
# (manage.mailbox.org > Email app-passwords).
MAILBOX_EMAIL=you@mailbox.org
MAILBOX_PASSWORD=

# Optional: default sender and display name
MAILBOX_FROM=
MAILBOX_FROM_NAME=

# Optional: your aliases, comma-separated (used to skip yourself in reply-all)
MAILBOX_ALIASES=

# Optional: app passwords from app.mailbox.org > All settings > Security > Application Passwords
# "Calendar and Addressbook Client (CalDAV/CardDAV)": contacts, tasks, calendar
MAILBOX_DAV_PASSWORD=
# "WebDAV Client": Drive files
MAILBOX_DRIVE_PASSWORD=

# Optional: PGP private key for decrypting and signing (armored file) and its passphrase
MAILBOX_PGP_PRIVATE_KEY_FILE=
MAILBOX_PGP_PASSPHRASE=
# 1 = also look up missing recipient keys on keys.openpgp.org (shares addresses with that service)
MAILBOX_PGP_KEYSERVER=

# Optional: business accounts only (manage.mailbox.org > API access)
MAILBOX_API_KEY=

# Optional overrides
# MAILBOX_IMAP_HOST=imap.mailbox.org
# MAILBOX_SMTP_HOST=smtp.mailbox.org
# MAILBOX_SIEVE_PORT=4190
# MAILBOX_DAV_URL=https://dav.mailbox.org
# MAILBOX_DOWNLOAD_DIR=
# MAILBOX_STATE_DIR=
